# Where the White Stupa website project lives (relative to this folder).
SITE_DIR=../../white-stupa-react

# Address of the website, used for "View" links and image previews in a built admin.
VITE_SITE_URL=http://localhost:5173

# Optional: your backend. When set, sign-in, loading, publishing and uploads go through it.
# VITE_API_URL=https://api.whitestupabhutan.com

# White Stupa API (white-stupa-react/server; run `npm run dev:all` in white-stupa-react). Sign-in, publishing, images,
# enquiries, bookings and the team all go through it.
VITE_API_URL=http://localhost:4000/api
